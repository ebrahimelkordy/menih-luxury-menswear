  promoDiscountPercent  Int      @default(10)
  bundleDiscountPercent Int      @default(15)
  freeShippingThreshold Int      @default(1500)
  flatShippingRate      Int      @default(50)
  contactPhone          String   @default("+20 100 000 0000")
  contactWhatsapp       String   @default("+20 100 000 0000")
  contactEmail          String   @default("concierge@ezar.com")
  instagramUrl          String   @default("https://instagram.com/ezar_luxury")
  facebookUrl           String   @default("https://facebook.com/ezar_luxury")
  tiktokUrl             String   @default("https://tiktok.com/@ezar_luxury")
  address               String   @default("Sultan Hussein St., Heliopolis, Cairo, Egypt")
  addressAr             String   @default("شارع السلطان حسين، مصر الجديدة، القاهرة، جمهورية مصر العربية")
  mixMatchCategories    String[] @default(["thobe", "shemagh", "bisht", "accessories", "fragrances"])
  logoUrl               String   @default("")
  brandName             String   @default("EZAR")
  brandNameAr           String   @default("إزار")
  updatedAt             DateTime @updatedAt

  @@map("site_settings")
}

model Testimonial {
  id           String   @id @default(uuid())
  name         String
  nameAr       String
  city         String
  cityAr       String
  review       String
  reviewAr     String
  rating       Int      @default(5)
  image        String   @default("/images/bisht-royal.jpg")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("testimonials")
}

/// Stores encrypted API keys — never stores plaintext
model AppSecrets {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  iv        String
  authTag   String
  updatedAt DateTime @updatedAt

  @@map("app_secrets")
}
